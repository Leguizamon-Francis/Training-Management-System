# Copiar este archivo como ".env" y completar los valores reales.
# El archivo .env NO se sube al repositorio.

NODE_ENV=development
PORT=3000

# Solo en producción. HOST: dirección donde escucha (por defecto 0.0.0.0 en producción y 127.0.0.1 en desarrollo).
# TRUST_PROXY: cantidad de proxies delante del servidor (en un hosting suele ser 1).
# HOST=0.0.0.0
# TRUST_PROXY=1

# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Si la contraseña tiene caracteres especiales (@, #, /, :, %), hay que codificarlos (ej.: @ -> %40).
DATABASE_URL="postgresql://postgres:CAMBIAR_CONTRASEÑA@localhost:5432/entrenamiento?schema=public"

# Plantilla PDF de las rutinas viejas, relativa a la carpeta backend (opcional; por defecto ../rutina.pdf).
# Las plantillas de los modelos actuales se generan con npm run plantillas.
# PLANTILLA_RUTINA=../rutina.pdf

# Copias de seguridad (npm run respaldo). Opcionales: carpeta de las copias (por defecto ../respaldos)
# y carpeta de los programas de PostgreSQL.
# RESPALDOS_DIR=../respaldos
# Clave para cifrar las copias (mínimo 16 caracteres; obligatoria en producción).
# Guardarla fuera del servidor: sin ella las copias no se pueden recuperar.
# RESPALDO_CLAVE=
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# "¿Olvidaste tu contraseña?": el mail se manda con Resend (https://resend.com). Sin clave, en desarrollo el
# link se muestra en la consola del backend; en producción hacen falta la clave y URL_PUBLICA.
# RESEND_API_KEY=
# URL_PUBLICA=https://dvtraining.com.ar
# EMAIL_REMITENTE=DV Training <no-responder@dvtraining.com.ar>

# Subir cada copia a Backblaze B2 (obligatorio en producción). Clave de solo escritura limitada a un bucket.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
