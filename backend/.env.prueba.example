# Servidor de prueba con datos inventados. Copiar como ".env.prueba" y completar la contraseña.
# Lo usan la base de prueba (docs/base-de-prueba.md) y las pruebas automáticas de aislamiento (npm test).
NODE_ENV=development
PORT=3000
# Base de control de prueba. Los gimnasios de prueba usan el mismo servidor, cada uno con su base.
DATABASE_URL="postgresql://postgres:CAMBIAR_CONTRASEÑA@localhost:5432/entrenamiento_prueba_control?schema=public"
# Solo para crear migraciones nuevas (npm run db:migrate): la base de un gimnasio de prueba.
CENTRO_DATABASE_URL="postgresql://postgres:CAMBIAR_CONTRASEÑA@localhost:5432/entrenamiento_prueba?schema=public"
