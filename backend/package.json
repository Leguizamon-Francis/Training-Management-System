{
  "name": "entrenamiento-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "generar": "prisma generate && prisma generate --schema prisma/control/schema.prisma",
    "build": "npm run generar && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev:prueba": "tsx watch --env-file=.env.prueba src/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:control": "prisma migrate dev --schema prisma/control/schema.prisma",
    "db:deploy": "tsx --env-file-if-exists=.env src/scripts/migrar.ts",
    "db:studio": "prisma studio",
    "plantillas": "tsx src/scripts/generar-plantillas.ts",
    "crear-admin": "tsx --env-file-if-exists=.env src/scripts/crear-admin.ts",
    "centros": "tsx --env-file-if-exists=.env src/scripts/centros.ts",
    "respaldo": "tsx --env-file-if-exists=.env src/scripts/respaldo.ts",
    "respaldo:probar": "tsx --env-file-if-exists=.env src/scripts/respaldo.ts --probar",
    "respaldo:descifrar": "tsx --env-file-if-exists=.env src/scripts/respaldo.ts --descifrar",
    "prueba:preparar": "tsx --env-file=.env.prueba src/scripts/migrar.ts",
    "centros:prueba": "tsx --env-file=.env.prueba src/scripts/centros.ts",
    "datos-ejemplo": "tsx --env-file=.env.prueba src/scripts/datos-ejemplo.ts",
    "test": "tsx --env-file-if-exists=.env.prueba --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
